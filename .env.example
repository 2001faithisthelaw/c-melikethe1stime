# Variables para Vercel (Settings → Environment Variables). Nada de esto se sube al repo.

# Base de datos: al conectar Upstash Redis desde Vercel (Storage → Marketplace → Upstash)
# se cargan solas como KV_REST_API_URL y KV_REST_API_TOKEN. También se aceptan:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Contraseña del panel /admin.html (elegí una larga). Sin esto el panel queda apagado.
ADMIN_TOKEN=

# Sal para el código anónimo de cada conexión (cualquier texto largo y secreto).
IP_SALT=

# Opcional
# STORE_RAW_IP=1          guarda también la IP completa (por defecto NO: sólo un código)
# FAV_THRESHOLD=70        puntaje desde el que un mensaje entra solo a favoritos
# ALLOWED_ORIGINS=https://2001faithisthelaw.github.io   orígenes que pueden llamar a la API
